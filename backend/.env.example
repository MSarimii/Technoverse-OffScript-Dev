PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/technoverse
JWT_SECRET=replace_with_a_secure_random_64_character_string_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# OpenRouter AI Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=HackathonApp
USE_MOCK_AI=true

# AI Configuration Notes (feat/ai):
# - Set USE_MOCK_AI=true for 100% offline deterministic keyword heuristic (default)
# - Set USE_MOCK_AI=false to enable live OpenRouter completions with OPENROUTER_API_KEY
# - Live mode enforces 15s timeout, 429 rate limit retry with budget, and Zod output validation

